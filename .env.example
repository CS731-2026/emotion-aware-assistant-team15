# Optional local LLM environment overrides for local development.
# Do not put real API keys in this file.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=CS731 Local Assistant

# Prefer /settings model profiles for role assignment.
LLM_PROVIDER=openrouter
LLM_MODEL=

STRATEGY_PLANNER_PROVIDER=openrouter
STRATEGY_PLANNER_MODEL=

# Optional embedding configuration for the RAG path.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
